# Copy to .env. Never commit .env, API keys, database URLs or R2 credentials.
# The values below are SAFE LOCAL DEVELOPMENT DEFAULTS ONLY; production needs PostgreSQL, R2, and strong secrets.
APP_ENV=development
APP_NAME=PesaGuard Registry Datasource
DATABASE_URL=sqlite:///./registry.db
# Replace with a long random LOCAL-ONLY key (e.g. `openssl rand -hex 32`) before starting the stack.
REGISTRY_API_KEYS=replace-with-a-long-random-secret
# Explicit origins only; '*' is rejected because the dashboard uses credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800
MAX_DIRECT_UPLOAD_BYTES=5368709120
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
UPLOAD_TTL_GRACE_SECONDS=900
MAX_RECORDS_PER_FILE=1000000
INGESTION_BATCH_SIZE=5000
LOCAL_STORAGE_PATH=./.registry-uploads
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=30
WORKER_RETRY_MAX_SECONDS=900
WORKER_MAX_JOBS_PER_RUN=10
# Jobs write a heartbeat at every checkpoint; keep the stale threshold well above
# WORKER_COMMIT_INTERVAL_SECONDS so only genuinely dead workers are recovered.
WORKER_STALE_AFTER_SECONDS=900
WORKER_COMMIT_INTERVAL_SECONDS=60
# PostgreSQL only: isolate each row so one bad row is skipped instead of failing the whole job.
INGESTION_ROW_SAVEPOINTS=true
ENTITY_RESOLUTION_MAX_CANDIDATES=200

# Cloudflare R2 (leave blank locally; files then go to LOCAL_STORAGE_PATH).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Frontend build argument (the production image requires it at build time).
VITE_API_BASE_URL=http://localhost:8000

# Dashboard sign-in. Generate the hash with:  python -m src.admin_auth hash-password
# Leave blank to disable dashboard login. SESSION_SECRET must be >= 32 random characters.
# SESSION_COOKIE_SECURE must be true in production; set false only for plain-http local development.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
ADMIN_LOGIN_MAX_ATTEMPTS_PER_MINUTE=10

# Customer API environment: sandbox or production. Sandbox keys are rejected in production and vice versa.
API_ENVIRONMENT=sandbox
# Customer key management: configure from the trusted PesaGuard auth_rbac issuer.
# Preferred: use the same rotating key ring, active kid, issuer and audience as the PesaGuard identity service.
# Keep secrets in the deployment secret manager; never commit the real values.
API_KEY_AUTH_JWT_KEYS_JSON=
API_KEY_AUTH_JWT_ACTIVE_KID=current
# Single-key compatibility only; prefer API_KEY_AUTH_JWT_KEYS_JSON for key rotation.
API_KEY_AUTH_JWT_SECRET=
API_KEY_AUTH_JWT_ISSUER=pesaguard
API_KEY_AUTH_JWT_AUDIENCE=pesaguard-api

# Redis is required in production when ADMIN_PASSWORD_HASH is configured: distributed login token bucket + cache.
# Blank Redis is permitted for local development only; login rate limits then use an in-process fallback.
REDIS_URL=
HMAC_SHARED_SECRET=
REQUIRE_HMAC=false
HMAC_CLOCK_SKEW_SECONDS=300
HMAC_NONCE_TTL_SECONDS=600
REGISTRY_RATE_LIMIT_CAPACITY=60
REGISTRY_RATE_LIMIT_REFILL_PER_SECOND=1.0
REGISTRY_CACHE_TTL_SECONDS=300
REGISTRY_CACHE_NEGATIVE_TTL_SECONDS=30
# Set a strong server-side token to expose the protected Prometheus /metrics endpoint.
METRICS_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
